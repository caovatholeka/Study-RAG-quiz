# === StudyRAG Environment Configuration ===

# Database URL (SQLite mặc định)
DATABASE_URL=sqlite:///./study_rag.db

# === LLM Provider Configuration ===
# "auto" (tự nhận diện theo key), "openai", hoặc "gemini"
LLM_PROVIDER=auto

# OpenAI API (Khuyên dùng - gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API (Tùy chọn dự phòng)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Đường dẫn lưu ChromaDB
CHROMA_DB_PATH=./chroma_db

# Model embedding đa ngôn ngữ
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Thư mục lưu file upload
UPLOAD_DIR=./uploads

# Số câu hỏi tối đa mặc định
MAX_QUESTIONS_PER_CHAPTER=15

# Cấu hình chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
